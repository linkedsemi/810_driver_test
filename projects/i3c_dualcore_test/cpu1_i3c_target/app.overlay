&i3c6 {
    status = "okay";
    is-secondary;
    interrupts = <I3C6_IRQN 7>;
    tgt-pid = <0x0208 0x13811000>;
    dcr = <0x4>;
    bcr = <0x06>;
    /* 静态地址：写进 SCONFIG.SADDR，硬件据此响应 SETDASA/SETAASA 广播
     * （setaasa/setdasa 测试项用；日常传输仍走 ENTDAA 分配的 0x32，
     * MATCHSS 未置位，静态地址不影响正常数据通路）。与协议头
     * I3C_TARGET_STATIC_ADDR 保持一致。 */
    static-address = <0x5a>;

    pinctrl-0 = <
        &i3c6_scl_pj08
        &i3c6_sda_pj09
    >;
    pinctrl-names = "default";
};

/* GPIO toggle 使能块统一走公共层（SPEC_REFERENCE §6.1.9 复用收敛）：
 * 使能 GPIOA（PA05/PA07 翻转线程所在端口），label 调整只改公共文件。
 * GPIO toggle 仅 cpu1 使用，cpu2 侧固件不编入 gpio_toggle.c、不 include 本片段。 */
#include "../../../common/gpio_toggle.dtsi"

/* RLOG 单出口通道（SPEC_REFERENCE §6.9.3）：两核 token 汇成一路串口流。
 * `channel` 单元格必须等于本节点在 `&mbox` 子节点中的**序号**（驱动按
 * DT_INST_FOREACH_CHILD_STATUS_OKAY 的遍历序索引 FIFO）：板级已占 0..3，
 * 本项目追加 ⇒ 序号 4。两核必须一致；宽 128 与本工程 RLOG 帧长（127B）匹配。 */
&mbox {
	rlog_channel: rlog_channel {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mbox 4 128 8 128 8>;
		mbox-names = "mbox";
	};
};
