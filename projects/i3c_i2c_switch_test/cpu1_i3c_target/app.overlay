/*
 * I3C/I2C 模块切换测试：target（cpu1）侧总线配置。
 *
 * 被测对象：I3C6（i3c@40094400，I3C target 角色）与 i2c6
 * （i2c@40084400，I2C slave 角色）共用引脚 PJ08/PJ09，模式由引脚
 * 复用（pinctrl）区分：
 *   - "default"     状态 = I3C 引脚复用（i3c6_scl_pj08 / i3c6_sda_pj09）
 *   - "pinmux_i2c"  状态 = I2C 引脚复用（I2C6_scl_PJ08 / I2C6_sda_PJ09）
 *
 * 注意：I2C6 引脚复用节点（I2C6_scl_PJ08 / I2C6_sda_PJ09，pinmux 0x8198/0x8199）
 * 由 soc dtsi（i2c 统一配置块）提供，本工程直接引用，不再自定义；
 * 而 lsqsh_pinctrl_fixed_pinmap.dtsi 中同功能小写节点（i2c6_scl_pj08）已被注释。
 */

/* i2c6 在 soc dtsi 中已有 pinctrl-0（default = I2C 引脚复用），若不置
 * pinctrl-noinit，i2c6 驱动 init 会把引脚切成 I2C 模式，破坏 i3c6 的
 * I3C 默认模式。引脚复用由 i3c6 节点的 pinctrl 双状态统一管理。 */

&i3c6_scl_pj08 {
    drive-push-pull;
};

&i3c6_sda_pj09 {
    drive-push-pull;
};

&i3c6 {
    status = "okay";
    is-secondary;
    interrupts = <I3C6_IRQN 7>;
    tgt-pid = <0x0208 0x13811000>;
    dcr = <0x4>;
    bcr = <0x06>;
    static-address = <0x5a>;

    pinctrl-0 = <
        &i3c6_scl_pj08
        &i3c6_sda_pj09
    >;
    pinctrl-1 = <
        &I2C6_scl_PJ08
        &I2C6_sda_PJ09
    >;
    pinctrl-names = "default", "pinmux_i2c";
};

/* i2c6 复用 I3C6 的引脚（PJ08/PJ09）：pinctrl-noinit 阻止 init 时 apply
 * soc 的 default 状态（I2C 引脚复用），引脚由 i3c6 节点双状态动态切换。
 * i2c6 slave 地址（0x50）由固件 i2c_target_register 时指定。
 * bus-frequency = 400K（与 controller 侧 i2c5 匹配）。 */
&i2c6 {
    status = "okay";
    pinctrl-noinit;
    bus-frequency = <400000>;
};

/* GPIO toggle 使能块统一走公共层（SPEC_REFERENCE §6.1.9 复用收敛）：
 * 使能 GPIOA（PA05/PA07 翻转线程所在端口），label 调整只改公共文件。
 * GPIO toggle 仅 cpu1 使用，cpu2 侧固件不编入 gpio_toggle.c、不 include 本片段。 */
#include "../../../common/gpio_toggle.dtsi"

/* RLOG 单出口通道（SPEC_REFERENCE §6.9.3）：本核（target）的 token 经此通道
 * 交给 controller 统一打印，本核串口不再出 token（LOG/panic 仍走本地）。
 * `channel` 单元格必须等于本节点在 `&mbox` 子节点中的**序号**（驱动按
 * DT_INST_FOREACH_CHILD_STATUS_OKAY 的遍历序索引 FIFO，spec 的 channel_id
 * 直接当数组下标），以 zephyr.dts 里 `&mbox` 的子节点顺序为准：板级现有
 * 5 个 consumer（0..4），本项目追加 ⇒ 序号 5。两核必须一致。
 * 宽 64 与 RLOG 帧长（63B）匹配；深度 8 覆盖从核一拍内的连发。 */
&mbox {
	rlog_channel: rlog_channel {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mbox 5 64 8 64 8>;
		mbox-names = "mbox";
	};
};
