/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * spi_test overlay（单核 cpu1 安全域）。
 *
 * 两套被测路径：
 *   A. 原有 18 项：spi1 / spi2（linkedsemi,ls-spi -> zephyr/drivers/spi/spi_ls.c）
 *      片内 pinctrl + CS GPIO，无外部接线。
 *   B. 新增 flash 访问：spif3（linkedsemi,spi-filter）master 态 -> spi4
 *      （snps,designware-spi）-> flash4_0（jedec,spi-nor /
 *      zephyr/drivers/flash/spi_nor_multi_dev.c）。板载，无外部接线。
 *
 * 2026-10-27：删除 SPI1↔SPI3 外部跳线回环（spi_loopback.c 已删），
 *             spif3 只作为 flash4_0 的 master 使用。
 */

#include "lsqsh_pinctrl_pfr_tpm.dtsi"

/ {
	chosen {
		zephyr,console = &uart1;
	};

	aliases {
		/* spif3 master 态驱动 flash4_0；用例统一从这两个 alias 取设备 */
		spifilter = &spif3;
		spiflash = &flash4_0;
	};
};

/* -------------------------------------------------------------------------- */
/* A. 原有 spi_ls 用例：spi1 / spi2                                            */
/* -------------------------------------------------------------------------- */

/* spi1：PA00=SCK / PA01=MOSI / PA02=MISO，CS = gpioa 3（板级 pinctrl 已声明） */
&spi1 {
	status = "okay";
};

/* spi2：PJ12=SCK / PJ13=MOSI / PJ14=MISO，CS = gpioj 15（板级 pinctrl 已声明） */
&spi2 {
	status = "okay";
};

/*
 * spi2 的 CS 在 GPIOJ —— 板级已使能该端口；这里显式保留，避免板级配置变动时
 * spi_ls_init() 的 spi_context_cs_configure_all() 静默 -ENODEV。
 */
&gpioj {
	status = "okay";
};

/* -------------------------------------------------------------------------- */
/* B. 新增 flash 访问：spif3 -> spi4 -> flash4_0                               */
/* -------------------------------------------------------------------------- */

/*
 * spif3 的配对 filter 是 spif4（spi_filter.c:1497-1502 的
 * spif_spi_check_dev_name_arr）。spif_switch_to_master() 会 device_get_binding
 * 配对节点；若 spif4 未使能会命中 __ASSERT_NO_MSG(0)，故必须一起打开。
 * spif4 只保持默认（filter）态，不切 master。
 */
&spif3 {
	cmd-page-program-quad-addr-quad-data = <0xc2>;
	cmd-quad-spi-mode-enter = <0x38>;
	cmd-quad-spi-mode-exit = <0xff>;
	status = "okay";
};

&spif4 {
	cmd-page-program-quad-addr-quad-data = <0xc2>;
	cmd-quad-spi-mode-enter = <0x38>;
	cmd-quad-spi-mode-exit = <0xff>;
	status = "okay";
};

/*
 * spi4 的总线引脚由 spif3 的 master pinctrl（pinctrl-2）驱动，DW SPI 控制器
 * 自己的板级 pinctrl 必须让出来（pfr_tpm dtsi 已清空，这里再显式写一次）。
 * flash4_0 挂在 spi4 的 CS0 上。
 */
&spi4 {
	cs-gpios = <&gpioi 0 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <>;
	pinctrl-names = "default";
	dmas = <&dmac2 6 DMA_SPI4_RX>, <&dmac2 6 DMA_SPI4_TX>;
	dma-names = "rx", "tx";
	status = "okay";

	flash4_0: flash4@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(50)>;
		spi-max-buswidth = <4>;
		re-init-support;
		status = "okay";
	};
};

/*
 * spif3/spi4 的 dmas 引用 dmac2；spi_dw.c 要求 DMA 控制器已使能，
 * 且 CONFIG_DMA_DW_LLI_POOL_SIZE 只在 DW DMA 编入时才有定义。
 */
&dmac2 {
	status = "okay";
};

/* GPIO toggle 使能块统一走公共层（SPEC_REFERENCE §6.1.9 复用收敛）。 */
#include "../../../common/gpio_toggle.dtsi"
