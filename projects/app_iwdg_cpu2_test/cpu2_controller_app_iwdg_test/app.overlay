/*
 * app_iwdg_cpu2_test - cpu2 (controller) side overlay
 *
 * 控制台走公共层 cpu2_console_uart5.overlay（uart5, PN14/PN13, 115200）。
 * 本文件只声明被测实例：app_iwdg@0x40099000（HART 复位域，cpu2）。
 * 注意 cpu2 侧**不得** include gpio_toggle.dtsi（GPIOA 双核共享，
 * common_sources.cmake 已按 BOARD_QUALIFIERS 把 gpio_toggle.c 排除在 cpu2 外）。
 */

&app_iwdg {
	status = "okay";
};

/* RLOG 单出口通道（SPEC_REFERENCE §6.9.3）：两核 token 汇成一路串口流。
 * `channel` 单元格必须等于本节点在 `&mbox` 子节点中的**序号**（驱动按
 * DT_INST_FOREACH_CHILD_STATUS_OKAY 的遍历序索引 FIFO）：板级已占 0..3，
 * 本项目追加 ⇒ 序号 4。两核必须一致；宽 128 与本工程 RLOG 帧长（127B）匹配。 */
&mbox {
	rlog_channel: rlog_channel {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mbox 4 128 8 128 8>;
		mbox-names = "mbox";
	};
};
