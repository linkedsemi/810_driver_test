# mbox_test cpu1 (target) 应用 Kconfig 根。
# 必须先引入 Zephyr 主配置树，否则整个符号树缺失。

source "$(ZEPHYR_BASE)/Kconfig.zephyr"

# 扩展 case 选择（P1c 追加）。
# 0 = 不编入扩展 case，走原有 mbox_target_main()（case_mbox_basic 原行为）。
config MBOX_TEST_CASE_ID
	int "mbox 扩展 case 编号（0 = 不启用）"
	default 0
	help
	  1 = big_crc   : 4 KB 分片传输 + CRC32 校验
	  2 = stress    : 1000 条往返，丢包/序号/CRC/延迟统计
	  3 = consumers : ch1..ch5 consumer 通路 + 同通道双向
	  4 = invalid   : 异常参数（controller 侧）
	  5 = rtc_sync  : RTC 双核时间同步
	  6 = fifo_full : 屏蔽 IRQ 期 FIFO 满 → -ENOSPC 与补排
