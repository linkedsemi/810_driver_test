/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * OTBN 单核测试 overlay：指定 zephyr,entropy = trng1 并使能
 * （RSA keygen 候选素数生成必须真随机源，见 otbn-rsa-keygen-record.md §6）。
 * dmac2 供带 DMA 的硬件路径使用。
 */

/ {
	chosen {
		zephyr,entropy = &trng1;
	};
};

&trng1 {
	status = "okay";
};

&dmac2 {
	status = "okay";
};

/* GPIO toggle 使能块统一走公共层（SPEC_REFERENCE §6.1.9 复用收敛）：
 * 使能 GPIOA（PA05/PA07 翻转线程所在端口），label 调整只改公共文件。
 * GPIO toggle 仅 cpu1 使用，cpu2 侧固件不编入 gpio_toggle.c、不 include 本片段。 */
#include "../../../common/gpio_toggle.dtsi"
