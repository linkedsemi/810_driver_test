/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * TRNG 单核测试 overlay：指定 zephyr,entropy = trng1 并使能。
 * （熵源选择必须显式 chosen，否则随机子系统可能落到其他熵设备）
 *
 * trng0（APB ring-oscillator TRNG）是独立模块，本工程同时测试，
 * 但不作为系统熵源——chosen 仍指向 trng1。
 */

/ {
	chosen {
		zephyr,entropy = &trng1;
	};
};

&trng1 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

/* GPIO toggle 使能块统一走公共层（SPEC_REFERENCE §6.1.9 复用收敛）：
 * 使能 GPIOA（PA05/PA07 翻转线程所在端口），label 调整只改公共文件。
 * GPIO toggle 仅 cpu1 使用，cpu2 侧固件不编入 gpio_toggle.c、不 include 本片段。 */
#include "../../../common/gpio_toggle.dtsi"
