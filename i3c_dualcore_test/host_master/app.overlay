&chosen {
    zephyr,console = &uart4;
    zephyr,shell-uart = &uart4;
};

&uart5 {
    status = "disabled";
};

&uart4 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <
        &uart4_tx_pa12
        &uart4_rx_pa13
    >;
    pinctrl-names = "default";
};

&i3c5_scl_pj10 {
    drive-strength = <1>;
    bias-pull-up2;
};

&i3c5_sda_pj11 {
    drive-strength = <1>;
    bias-pull-up2;
};

&i3c5 {
    status = "okay";
    i3c-scl-hz = <12500000>;
    interrupts = <I3C5_IRQN 6>;

    tgt-pid = <0x5 0x55>;
    dcr = <0x4>;
    bcr = <0x42>;

    pinctrl-0 = <
        &i3c5_scl_pj10
        &i3c5_sda_pj11
    >;
    pinctrl-names = "default";

    i3ctarget6: i3ctarget@46a00000000 {
        compatible = "vnd,i3c-device";
        reg = <0 0x046a 0x00000000>;
        assigned-address = <0x38>;
        status = "okay";
    };
};
